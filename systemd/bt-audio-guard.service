[Unit]
Description=Keep Bluetooth headphones connected and in A2DP across logout/login
# Runs with the graphical session: restore at login, save at logout.
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/bt-audio-guard restore
ExecStop=%h/.local/bin/bt-audio-guard save

[Install]
WantedBy=graphical-session.target
